# First, calculate the key statistics for reporting
library(broom)

summary_stats <- all_disc_clean %>%
  group_by(age_group, trial_type) %>%
  summarise(
    accuracy = mean(Correct, na.rm = TRUE),
    sd = sd(Correct, na.rm = TRUE),
    se = sd / sqrt(n()),
    ci_lower = accuracy - 1.96 * se,
    ci_upper = accuracy + 1.96 * se,
    n = n(),
    n_correct = sum(Correct, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    # Test if significantly above chance (50%)
    z_score = (accuracy - 0.5) / se,
    p_vs_chance = 2 * (1 - pnorm(abs(z_score))),
    sig_above_chance = ifelse(p_vs_chance < 0.05 & accuracy > 0.5, "*", "")
  )

print(summary_stats)

# Create a formatted table for reporting
reporting_table <- summary_stats %>%
  mutate(
    # Format for manuscript
    reporting = sprintf("%.1f%% [%.1f%%, %.1f%%] (n=%d)", 
                       accuracy*100, ci_lower*100, ci_upper*100, n)
  ) %>%
  select(age_group, trial_type, reporting)

print(reporting_table)

