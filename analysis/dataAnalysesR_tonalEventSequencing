cat("\n\n=== TOJ TASK: CORRELATION BETWEEN ACCURACY AND MS ===\n\n")

# Load TOJ specific data
toj_file_path <- "C:/xxx//Temporal Order Judgement.xlsx"
toj_data <- read_excel(toj_file_path)


# Clean column names and prepare data

toj_data <- toj_data %>%
  janitor::clean_names() %>%
  mutate(
    id = as.factor(id),
    correct = as.numeric(correct),
    age_group = case_when(
      is.na(age_group) | age_group == "N/A" ~ "Adult",
      TRUE ~ as.character(age_group)
    ),
    age_group = factor(age_group, levels = c("4", "6", "Adult")),
    ms = as.numeric(ms)
  )%>%
  filter(ms != 60)  # <-- Add %>% before this line to continue the pipe

# Calculate participant accuracy before exclusions
participant_accuracy <- toj_data %>%
  group_by(id, age_group) %>%
  summarise(
    accuracy = mean(correct, na.rm = TRUE),
    n_trials = sum(!is.na(correct)),
    .groups = "drop"
  )

# Identify adults below 60% overall accuracy
excluded_adults <- participant_accuracy %>%
  filter(age_group == "Adult", accuracy < 0.60)

# Inspect the IDs, accuracy scores, and number excluded
print(excluded_adults)
cat("Adults excluded:", nrow(excluded_adults), "\n")

# Retain the complete dataset for sensitivity analyses
toj_data_all <- toj_data

# Apply exclusions before summaries, plots, and models
toj_data <- toj_data %>%
  anti_join(
    excluded_adults %>% select(id, age_group),
    by = c("id", "age_group")
  )

# Aggregate across intervals: one accuracy score per participant
toj_by_participant <- toj_data %>%
  group_by(id, age_group) %>%
  summarise(
    accuracy = mean(correct, na.rm = TRUE),
    .groups = "drop"
  )

# Check manuscript means, SDs, and sample sizes
toj_by_participant %>%
  group_by(age_group) %>%
  summarise(
    n = n(),
    M = mean(accuracy),
    SD = sd(accuracy),
    .groups = "drop"
  ) %>%
  print()

