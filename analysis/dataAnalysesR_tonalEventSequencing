# Load required library
library(lme4)

# Create a prediction grid with all combinations of ms and age_group
# Use the original ms values (not scaled) for interpretable x-axis
ms_range <- seq(min(toj_data$ms), max(toj_data$ms), length.out = 100)

pred_grid <- expand.grid(
  ms_scaled = scale(ms_range, 
                    center = attr(scale(toj_data$ms), "scaled:center"),
                    scale = attr(scale(toj_data$ms), "scaled:scale")),
  age_group = unique(toj_data$age_group)
)

# Add predictions from GLMM (on the response scale, i.e., probability)
pred_grid$predicted_prob <- predict(toj_glmm_scaled, 
                                     newdata = pred_grid, 
                                     type = "response", 
                                     re.form = NA)  # NA = population-level predictions (no random effects)

# Also get standard errors for confidence intervals
pred_grid$se <- predict(toj_glmm_scaled, 
                        newdata = pred_grid, 
                        type = "link", 
                        se.fit = TRUE, 
                        re.form = NA)$se.fit

# Convert from logit scale to probability scale for CI bounds
pred_grid$predicted_prob_link <- predict(toj_glmm_scaled, 
                                          newdata = pred_grid, 
                                          type = "link", 
                                          re.form = NA)
pred_grid$lower_link <- pred_grid$predicted_prob_link - 1.96 * pred_grid$se
pred_grid$upper_link <- pred_grid$predicted_prob_link + 1.96 * pred_grid$se
pred_grid$lower_prob <- plogis(pred_grid$lower_link)
pred_grid$upper_prob <- plogis(pred_grid$upper_link)

# Add back the original ms values (unscaled) for plotting
pred_grid$ms_unscaled <- ms_range

