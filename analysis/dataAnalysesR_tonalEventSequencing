library(quickpsy)

find_tbw50 <- function(ms, prop_async) {
  
  # Remove missing values
  keep <- !is.na(ms) & !is.na(prop_async)
  ms <- ms[keep]
  prop_async <- prop_async[keep]
  
  # Need at least two points
  if (length(ms) < 2) return(NA_real_)
  
  # Sort by timing
  ord <- order(ms)
  ms <- ms[ord]
  prop_async <- prop_async[ord]
  
  # Exact 50%
  if (any(prop_async == 0.50)) {
    return(ms[which(prop_async == 0.50)[1]])
  }
  
  # Find crossing of 50%
  for (i in 1:(length(ms) - 1)) {
    
    if ((prop_async[i] < 0.50 && prop_async[i + 1] > 0.50) ||
        (prop_async[i] > 0.50 && prop_async[i + 1] < 0.50)) {
      
      return(
        ms[i] +
        (0.50 - prop_async[i]) /
        (prop_async[i + 1] - prop_async[i]) *
        (ms[i + 1] - ms[i])
      )
    }
  }
  
  # No crossing within tested range
  return(NA_real_)
}

