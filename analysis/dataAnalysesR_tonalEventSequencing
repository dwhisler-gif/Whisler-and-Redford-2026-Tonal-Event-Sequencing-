# Method 2: IQR method
Q1 <- quantile(accuracy_by_month$accuracy, 0.25, na.rm = TRUE)
Q3 <- quantile(accuracy_by_month$accuracy, 0.75, na.rm = TRUE)
IQR_val <- Q3 - Q1

accuracy_by_month <- accuracy_by_month %>%
  mutate(
    is_outlier_iqr = (accuracy < (Q1 - 1.5*IQR_val)) | (accuracy > (Q3 + 1.5*IQR_val))
  )

cat("\nIQR outliers:\n")
cat(sprintf("Q1 = %.1f%%, Q3 = %.1f%%, IQR = %.1f%%\n", Q1, Q3, IQR_val))
cat(sprintf("Lower fence: %.1f%%, Upper fence: %.1f%%\n", 
            Q1 - 1.5*IQR_val, Q3 + 1.5*IQR_val))
outliers_iqr <- accuracy_by_month %>% 
  filter(is_outlier_iqr == TRUE) %>%
  dplyr::select(participant_public_id, ageGroupMonths, accuracy) %>%
  arrange(accuracy)
print(outliers_iqr)

# Method 3: Residuals from developmental model
month_model <- lm(accuracy ~ ageGroupMonths, data = accuracy_by_month)
accuracy_by_month <- accuracy_by_month %>%
  mutate(
    predicted_accuracy = predict(month_model),
    residual = accuracy - predicted_accuracy,
    std_residual = residual / sd(residual, na.rm = TRUE),
    is_outlier_resid = abs(std_residual) > 2.5
  )

cat("\nResidual-based outliers (standardized residuals > 2.5):\n")
outliers_resid <- accuracy_by_month %>% 
  filter(is_outlier_resid == TRUE) %>%
  dplyr::select(participant_public_id, ageGroupMonths, accuracy, predicted_accuracy, std_residual) %>%
  arrange(desc(abs(std_residual)))
print(outliers_resid)

