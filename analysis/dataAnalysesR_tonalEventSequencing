    n_total = n(),
    n_with_threshold = sum(!is.na(TBW_50)),
    n_without_threshold = sum(is.na(TBW_50)),
    percent_with_threshold = 100 * mean(!is.na(TBW_50)),
    .groups = "drop"
  )
