find_tbw50 <- function(ms, prop_async) {
  
  # Remove missing values
  keep <- !is.na(ms) & !is.na(prop_async)
  ms <- ms[keep]
  prop_async <- prop_async[keep]
  
  # Need at least two observations
  if (length(ms) < 2) return(NA_real_)
  
  # Sort by audio-video offset
  ord <- order(ms)
  ms <- ms[ord]
  prop_async <- prop_async[ord]
  
  # If exactly 50% occurs, use that offset
  if (any(prop_async == 0.50)) {
    return(ms[which(prop_async == 0.50)[1]])
  }
  
  # Find adjacent points that straddle .50
  crossing <- which(
    (prop_async[-length(prop_async)] < 0.50 &
       prop_async[-1] > 0.50) |
    (prop_async[-length(prop_async)] > 0.50 &
       prop_async[-1] < 0.50)
  )
  
  # No 50% crossing
  if (length(crossing) == 0) return(NA_real_)
  
  # Use first crossing
  i <- crossing[1]
  
  # Linear interpolation
  ms1 <- ms[i]
  ms2 <- ms[i + 1]
  p1 <- prop_async[i]
  p2 <- prop_async[i + 1]
  
  threshold <- ms1 + 
    (0.50 - p1) / (p2 - p1) * (ms2 - ms1)
  
  return(threshold)
}

tbw_thresholds <- tbw_individual_curve %>%
  group_by(ID, ageGroup) %>%
  summarise(
    TBW_50 = find_tbw50(MS, prop_async),
    .groups = "drop"
