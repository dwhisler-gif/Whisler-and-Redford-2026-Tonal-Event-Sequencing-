process_tbw <- function(file, age_label) {
  read_excel(file) %>%
    mutate(
      `Component Name` = trimws(`Component Name`),
      Response = str_trim(Response),
      age_group = age_label
    ) %>%
    filter(
      `Component Name` == "Click Response",
      !is.na(`Spreadsheet: TBW Video`),
      `Spreadsheet: TBW Video` != ""
    ) %>%
    mutate(
      Response_Norm = case_when(
        Response %in% c("A", "Yes") ~ "Synch",
        Response %in% c("B", "No")  ~ "Asynch",
        TRUE ~ NA_character_
      ),
      ID = as.factor(`Participant Private ID`),
      Timing = as.numeric(str_extract(`Spreadsheet: TBW Video`, "\\d+"))
    ) %>%
    filter(!is.na(Timing), !is.na(Response_Norm)) %>%
    group_by(ID, age_group, Timing) %>%
    summarise(
      prop_asynch = mean(Response_Norm == "Asynch"),
      .groups = "drop"
    )
}

