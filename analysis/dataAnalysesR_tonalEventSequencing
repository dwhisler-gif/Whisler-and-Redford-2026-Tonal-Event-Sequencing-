# Function to process each file
process_tbw_file <- function(filepath, age_group_name) {
  data <- read_excel(filepath)
  
  processed <- data %>%
    mutate(
      `Component Name` = trimws(`Component Name`),
      Response = str_trim(Response)
    ) %>%
    filter(
      `Component Name` == "Click Response",
      !is.na(`Spreadsheet: TBW Video`),
      `Spreadsheet: TBW Video` != ""
    ) %>%
    mutate(
      Response_Norm = case_when(
        Response %in% c("A", "Yes") ~ "Synch",
        Response %in% c("B", "No") ~ "Asynch",
        TRUE ~ NA_character_
      ),
      Response_Binary = ifelse(Response_Norm == "Asynch", 1, 0),  # 1 = Asynch, 0 = Synch
      id = as.character(`Participant Private ID`),
      Timing = as.numeric(str_extract(`Spreadsheet: TBW Video`, "\\d+")),
      age_group = age_group_name
    ) %>%
    filter(!is.na(Timing), !is.na(Response_Norm)) %>%
    dplyr::select(id, age_group, Timing, Response_Norm, Response_Binary)  # <- ADD dplyr:: here
  
  return(processed)
}

