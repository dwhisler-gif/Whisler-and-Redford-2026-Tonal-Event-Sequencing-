print(summary(model2))
cat("\nANOVA:\n")
print(Anova(model2, type = 3))
cat("\nEffect size (Eta-squared):\n")
print(etaSquared(model2))

# Model 3: Age Group + Task (main effects)
cat("\n\n--- Model 3: Age Group + Task (main effects) ---\n")
model3 <- lm(accuracy ~ ageGroup + Task, data = accuracy_by_id)
print(summary(model3))
cat("\nANOVA:\n")
